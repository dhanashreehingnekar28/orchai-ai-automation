# Copy to .env and fill only the provider key you intend to use.
# Never put real credentials in this tracked template.

GROQ_API_KEY=
ORCHAI_AI_PROVIDER=groq
ORCHAI_AI_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional alternative text and vision provider.
GEMINI_API_KEY=
ORCHAI_GEMINI_MODEL=
ORCHAI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Optional xAI text provider.
XAI_API_KEY=
ORCHAI_XAI_MODEL=grok-4.7

# ORCHAI local API server and persistence.
ORCHAI_PORT=4174
ORCHAI_STORAGE_DIR=./storage/runtime
